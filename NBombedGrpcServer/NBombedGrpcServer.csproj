<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Stated rather than inherited from the Web SDK. The GC mode determines every counter in
         the runtime CSV, so it must be a recorded fact. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <Protobuf Include="..\Protos\operation.proto" GrpcServices="Server" Link="Protos\operation.proto" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exact versions. -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.83.0" />
    <!-- Same version as the client. Both generate C# from the same .proto. -->
    <PackageReference Include="Grpc.Tools" Version="2.83.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NBombShared\NBombShared.csproj" />
  </ItemGroup>
</Project>